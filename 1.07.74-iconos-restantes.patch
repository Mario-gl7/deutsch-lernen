+/* ═══════════════════ ESTÉTICA PREMIUM · 1.07.71 ═══════════════════
+   Solo apariencia: tipografía, bordes finos, sombras difusas, movimiento y foco.
+   Usa únicamente las variables existentes, así las paletas de Ajustes siguen funcionando. */
+:root{
+  --font:'Geist',-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',system-ui,sans-serif;
+  --font-display:'Instrument Serif','Iowan Old Style','Palatino Linotype',Georgia,serif;
+  --ease:cubic-bezier(.32,.72,0,1);
+  --hair:color-mix(in srgb,var(--text) 9%,transparent);
+  --hair-strong:color-mix(in srgb,var(--text) 16%,transparent);
+  --lift:inset 0 1px 0 rgba(255,255,255,.05);
+  --amb:0 1px 2px rgba(0,0,0,.28),0 12px 32px -12px rgba(0,0,0,.55);
+  --amb-hover:0 1px 2px rgba(0,0,0,.3),0 20px 44px -14px rgba(0,0,0,.65);
+  --r:12px; --r-lg:20px;
+  color-scheme:dark;
+}
+html:has(body.light){color-scheme:light}
+body.light{
+  --hair:color-mix(in srgb,var(--text) 10%,transparent);
+  --lift:inset 0 1px 0 rgba(255,255,255,.8);
+  --amb:0 1px 2px rgba(80,65,30,.08),0 14px 34px -16px rgba(80,65,30,.22);
+  --amb-hover:0 1px 2px rgba(80,65,30,.1),0 22px 46px -16px rgba(80,65,30,.30);
+}
+
+html{-webkit-text-size-adjust:100%;scroll-padding-top:16px}
+body{
+  font-family:var(--font);letter-spacing:-.011em;line-height:1.5;
+  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility;
+  font-feature-settings:'ss01','cv11';
+  -webkit-tap-highlight-color:transparent;
+}
+button,input,select,textarea{font-family:var(--font);letter-spacing:inherit}
+button,a,[role=button],select,summary,label{touch-action:manipulation}
+::selection{background:rgba(var(--accent-rgb),.28);color:inherit}
+*{scrollbar-width:thin;scrollbar-color:var(--hair-strong) transparent}
+
+/* Titulares: serif de display, equilibrados */
+.login-title,.home-hero-title,.prog-title,.top-bar-title,.modal-box h3,.login-card h2{
+  font-family:var(--font-display);font-weight:400;letter-spacing:-.02em;text-wrap:balance;
+}
+.login-title{font-size:38px;line-height:1.05}
+.home-hero-title{font-size:44px;line-height:1.02}
+.prog-title{font-size:38px;line-height:1.05}
+.login-card h2,.modal-box h3{font-size:24px;line-height:1.15}
+.home-hero-sub,.login-subtitle{text-wrap:pretty;color:var(--text2)}
+
+/* Números: tabulares y con peso fino */
+.stat-num,.prog-pct,.prog-streak-n,.score-chip,td,.build-badge,[class*="timer"],[class*="score"]{font-variant-numeric:tabular-nums}
+.prog-pct,.prog-streak-n{font-family:var(--font-display);font-weight:400;letter-spacing:-.03em}
+.prog-pct small,.prog-streak-n small{font-family:var(--font);font-weight:500;letter-spacing:0}
+.prog-pct{font-size:54px}.prog-streak-n{font-size:32px}
+.stat-num{font-weight:500;letter-spacing:-.03em}
+
+/* Etiquetas pequeñas: capitular fina y aireada */
+.field-label,.stat-lbl,.dd-label,.prog-card-title{letter-spacing:.12em;font-weight:500}
+
+/* Superficies: doble capa (borde fino + brillo interior + sombra ambiental) */
+.login-card,.hub-card,.folder-card,.prog-card,.stat-tile,.modal-box,.dd-box,.setup-banner{
+  border:1px solid var(--hair);
+  box-shadow:var(--lift),var(--amb);
+  transition:transform .5s var(--ease),box-shadow .5s var(--ease),border-color .3s var(--ease),background-color .3s var(--ease);
+}
+.hub-card{border-radius:var(--r-lg)}
+.folder-card{border-radius:var(--r-lg)}
+.prog-card,.modal-box{border-radius:var(--r-lg)}
+.hub-card:hover,.folder-card:hover{
+  border-color:var(--hair-strong);box-shadow:var(--lift),var(--amb-hover);transform:translateY(-3px);
+}
+.hub-card:active,.folder-card:active{transform:scale(.985);transition-duration:.12s}
+.hub-card.disabled:hover{transform:none;box-shadow:var(--lift),var(--amb);border-color:var(--hair)}
+.hub-card-title{font-size:12px;font-weight:600;letter-spacing:-.005em}
+.hub-card-cover-emoji{transition:transform .6s var(--ease)}
+
+/* Botones */
+.btn-primary,.btn-login{
+  border-radius:var(--r);font-weight:600;letter-spacing:-.01em;
+  box-shadow:inset 0 1px 0 rgba(255,255,255,.28),0 1px 2px rgba(0,0,0,.25),0 8px 20px -10px rgba(var(--accent-rgb),.55);
+  transition:transform .35s var(--ease),filter .25s var(--ease),box-shadow .35s var(--ease),opacity .2s;
+}
+.btn-primary:hover,.btn-login:hover{opacity:1;filter:brightness(1.07) saturate(1.05)}
+.btn-primary:active,.btn-login:active{transform:scale(.97);transition-duration:.1s}
+.btn-secondary,.btn-blue,.cfg-chip,.prog-seg-btn,.pal-btn{
+  border-radius:var(--r);border-color:var(--hair);
+  transition:transform .3s var(--ease),background-color .25s var(--ease),border-color .25s var(--ease),color .25s var(--ease);
+}
+.btn-secondary:active,.btn-blue:active,.cfg-chip:active{transform:scale(.97)}
+
+/* Campos */
+.field-input,.cell-input,.cell-select{
+  border-color:var(--hair);border-radius:var(--r);
+  transition:border-color .25s var(--ease),box-shadow .25s var(--ease),background-color .25s var(--ease);
+}
+.field-input:focus,.field-input:focus-visible{
+  border-color:rgba(var(--accent-rgb),.7);box-shadow:0 0 0 4px rgba(var(--accent-rgb),.14);outline:none;
+}
+
+/* Foco visible para teclado (sin anillo al hacer clic) */
+:focus{outline:none}
+:focus-visible{outline:2px solid rgba(var(--accent-rgb),.9);outline-offset:2px;border-radius:inherit}
+.field-input:focus-visible{outline:none}
+
+/* Tarjetas de juego */
+.word-card{border-radius:14px;border-color:var(--hair);transition:transform .3s var(--ease),border-color .25s var(--ease),background-color .25s var(--ease),color .25s var(--ease)}
+.word-card:active{transform:scale(.97)}
+
+/* Barra de navegación: cristal más fino */
+.app-nav{border:1px solid var(--hair);box-shadow:var(--lift),0 18px 40px -16px rgba(0,0,0,.6)}
+.app-nav-pill{box-shadow:var(--lift)}
+
+/* Modales */
+.modal-overlay{backdrop-filter:blur(10px) saturate(1.1);-webkit-backdrop-filter:blur(10px) saturate(1.1)}
+.modal-box{overscroll-behavior:contain}
+
+/* Texto largo seguro en flex */
+.folder-card-body,.hub-card-label,.dd-row{min-width:0}
+.folder-card-body *,.hub-card-title{overflow-wrap:anywhere}
+
+/* Reduce movimiento si el sistema lo pide */
+@media (prefers-reduced-motion:reduce){
+  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
+}
+@media (pointer:fine){html{overscroll-behavior:none}}
+
+
+/* ═══ 1.07.72 · Misma estética en todas las páginas ═══ */
+/* Fondo ambiental (el de Inicio) común a todas las páginas */
+.app-ambient{position:fixed;inset:0;z-index:-1}
+body:has(#page-login.active) .app-ambient{display:none}
+/* Títulos de página como en Progresión */
+.page-head{width:100%;max-width:760px;margin:0 auto;padding:0 16px}
+.hub-hero .prog-title{margin:8px 0 6px}
+.hub-hero{margin-bottom:24px}
+body.lectura-reading #lecturaTitle{display:none}
+#page-lectura .page-head .prog-title{margin-bottom:4px}
+/* Juegos: títulos en serif */
+.match-header h2{font-family:var(--font-display);font-weight:400;font-size:30px;letter-spacing:-.02em;line-height:1.05}
+/* Ajustes: tarjetas con el mismo tratamiento que el resto */
+#page-perfil .inner-content > div[style*="background:var(--surface)"]{border-color:var(--hair)!important;box-shadow:var(--lift),var(--amb)}
+#page-perfil [style*="text-transform:uppercase"]{letter-spacing:.12em!important;font-weight:500!important}
+/* Lectura: botones de la biblioteca */
+.lectura-upload-btn,.lectura-url-btn{border-radius:var(--r);border-color:var(--hair);transition:transform .3s var(--ease),border-color .25s var(--ease),background-color .25s var(--ease)}
+.lectura-upload-btn:active,.lectura-url-btn:active{transform:scale(.97)}
+/* Lectura: la biblioteca deja ver el fondo común; el lector conserva su fondo sólido */
+body:not(.lectura-reading) #page-lectura:not(.fullscreen-reader){background:none}
+/* Vocabulario y juegos: también muestran el fondo común */
+#page-vocab-hub,#page-lista,#page-parejas,#page-crucigrama,#page-velocidad{background:none}
+
+
+/* ═══ 1.07.73 · Iconos propios: trazo fino + acento del tema ═══
+   El trazo usa el color del texto y el detalle usa var(--accent), así que cada paleta (Main, Minimal Clean,
+   Nature, Warm, Cool, Soft Tech) y cada modo colorea los iconos con su propio acento. */
+.ico{width:1em;height:1em;flex:none;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;overflow:visible;vertical-align:-.14em}
+.ico-i{margin-right:.5em}
+.ws-card-cover-emoji,.hub-card-cover-emoji,.folder-card-icon,.import-zone-icon{display:inline-flex;align-items:center;justify-content:center;color:var(--text);line-height:0}
+.ws-card-cover-emoji .ico,.hub-card-cover-emoji .ico,.folder-card-icon .ico,.import-zone-icon .ico{stroke-width:2}
+.import-zone-icon{color:var(--text2)}
