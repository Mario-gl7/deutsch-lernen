 .dup-opt input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}
 @media (prefers-reduced-motion:reduce){.dup-opt span{transition:none}}
+
+/* 1.07.77 · carpeta = contenedor (subcarpetas) o lista (palabras) */
+.folder-move-group{
+  padding:8px 14px 2px;font-size:11px;font-weight:600;letter-spacing:.03em;text-transform:uppercase;
+  color:var(--text3);overflow-wrap:anywhere;
+}
+.loose-note{
+  display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;
+  margin:10px 12px 0;padding:10px 12px;border:1px solid var(--border2);border-radius:var(--r);
+  background:var(--bg2);font-size:12px;color:var(--text2);line-height:1.45;
+}
+.loose-note b{color:var(--text);font-weight:600}
+.notion-add-row:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
